# Database connection string (PostgreSQL via pg adapter / Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sst_erp?schema=public"

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Required for all application session and authentication tokens.
# Replace with a unique random secret of at least 32 characters.
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"

# Optional direct Google OAuth fallback when Supabase Google OAuth is unavailable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Subscription billing (Razorpay test mode only; key ID must start with rzp_test_)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Development only: bypass Super Admin sign-in for local UI work.
# This has no effect unless NODE_ENV is "development"; production always requires authentication.
SUPER_ADMIN_DEV_AUTH_BYPASS="false"

# Institution administrator invitation email delivery (Resend-compatible HTTP provider)
RESEND_API_KEY=""
INSTITUTION_INVITATION_FROM_EMAIL="SOHAN SOFT TECH ERP <noreply@example.com>"

# Development only: show illustrative dashboard data. This does not bypass authentication.
